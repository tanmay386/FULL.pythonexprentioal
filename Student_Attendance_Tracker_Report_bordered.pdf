BT 1 0 0 1 0 644.8 Tm /F6+0 8 Tf 9.6 TL (    for raw, expected in mark_cases:) Tj T* (        assert normalize_mark\(raw\) == expected, raw) Tj T*  T* (    total = len\(pct_cases\) + len\(status_cases\) + len\(mark_cases\)) Tj T* (    print\(f"Test suite: {total} / {total} automated tests passed."\)) Tj T*  T*  T* (def get_mark\(name\):) Tj T* (    while True:) Tj T* (        mark = normalize_mark\(input\(f"  {name} \(P/A\): "\)\)) Tj T* (        if mark is not None:) Tj T* (            return mark) Tj T* (        print\("  Invalid input. Please enter P or A."\)) Tj T*  T*  T* (def get_positive_int\(prompt\):) Tj T* (    while True:) Tj T* (        text = input\(prompt\).strip\(\)) Tj T* (        if text.isdigit\(\) and int\(text\) > 0:) Tj T* (            return int\(text\)) Tj T* (        print\("Invalid input. Please enter a number greater than zero."\)) Tj T*  T*  T* (def enter_students\(\):) Tj T* (    students = []) Tj T* (    count = get_positive_int\("Enter number of students: "\)) Tj T* (    for i in range\(1, count + 1\):) Tj T* (        name = input\(f"Enter name of student {i}: "\).strip\(\)) Tj T* (        while name == "":) Tj T* (            name = input\("Name cannot be empty. Enter again: "\).strip\(\)) Tj T* (        students.append\(\(i, name\)\)) Tj T* (    return students) Tj T*  T*  T* (def mark_attendance\(students, lectures, demo=False\):) Tj T* (    """records[roll] = list of 'P'/'A', one entry per lecture.""") Tj T* (    records = {roll: [] for roll, _ in students}) Tj T* (    for lec in range\(1, lectures + 1\):) Tj T* (        if not demo:) Tj T* (            print\(f"\\nLecture {lec}: mark attendance"\)) Tj T* (        for roll, name in students:) Tj T* (            if demo:) Tj T* (                mark = "P" if random.random\(\) < RATES[roll] else "A") Tj T* (            else:) Tj T* (                mark = get_mark\(f"{roll}. {name}"\)) Tj T* (            records[roll].append\(mark\)) Tj T* (    return records) Tj T*  T*  T* (def build_report\(students, records\):) Tj T* (    report = []) Tj T* (    for roll, name in students:) Tj T* (        total = len\(records[roll]\)) Tj T* (        present = records[roll].count\("P"\)) Tj T* (        pct = calculate_percentage\(present, total\)) Tj T* (        report.append\({"roll": roll, "name": name, "total": total,) Tj T* (                       "present": present, "absent": total - present,) Tj T* (                       "pct": pct, "status": get_status\(pct\)}\)) Tj T* (    return report) Tj T*  T*  T* (def analyze\(report\):) Tj T* (    pcts = [r["pct"] for r in report]) Tj T* (    defaulters = [r for r in report if r["status"] == "DEFAULTER"]) Tj T* (    return {) Tj T* (        "students": len\(report\),) Tj T* (        "average": sum\(pcts\) / len\(pcts\),) Tj T* (        "highest": max\(report, key=lambda r: r["pct"]\),) Tj T* ET
