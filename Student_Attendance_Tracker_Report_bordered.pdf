(        for r in report:) Tj T* (            if r["status"] == "DEFAULTER":) Tj T* (                print\(f"  {r['roll']}. {r['name']} - {r['pct']:.1f}%"\)) Tj T*  T*  T* (if __name__ == "__main__":) Tj T* (    main\(\)) Tj T* ET
