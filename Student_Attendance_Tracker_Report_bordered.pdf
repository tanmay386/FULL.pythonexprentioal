1 0 0 1 62 60.68976 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 0 558.4 Tm /F6+0 8 Tf 9.6 TL ("""Student Attendance Tracker - Mark Attendance and Show Report \(console version\).""") Tj T* (import random) Tj T* (import sys) Tj T*  T* (THRESHOLD = 75.0          # minimum attendance percentage) Tj T* (DEMO_SEED = 2026) Tj T* (DEMO_LECTURES = 20) Tj T*  T* (DEMO_STUDENTS = [) Tj T* (    \(1, "Aarav Deshmukh"\), \(2, "Isha Kulkarni"\), \(3, "Rohan Wankhede"\),) Tj T* (    \(4, "Sneha Thakre"\), \(5, "Vedant Raut"\), \(6, "Pooja Meshram"\),) Tj T* (    \(7, "Karan Bhise"\), \(8, "Nidhi Gawande"\),) Tj T* (]) Tj T* (# chance of being present for each demo student \(used only in demo mode\)) Tj T* (RATES = {1: 0.95, 2: 0.90, 3: 0.70, 4: 0.85, 5: 0.55, 6: 0.80, 7: 0.65, 8: 0.92}) Tj T*  T*  T* (def calculate_percentage\(present, total\):) Tj T* (    """Attendance % = \(present / total\) * 100. Returns 0.0 if no lecture held.""") Tj T* (    if total <= 0:) Tj T* (        return 0.0) Tj T* (    return present / total * 100) Tj T*  T*  T* (def get_status\(percentage\):) Tj T* (    """REGULAR if percentage >= THRESHOLD, else DEFAULTER.""") Tj T* (    return "REGULAR" if percentage >= THRESHOLD else "DEFAULTER") Tj T*  T*  T* (def normalize_mark\(raw\):) Tj T* (    """Clean the input. Returns 'P', 'A' or None for invalid input.""") Tj T* (    text = raw.strip\(\).lower\(\)) Tj T* (    if text in \("p", "present", "1"\):) Tj T* (        return "P") Tj T* (    if text in \("a", "absent", "0"\):) Tj T* (        return "A") Tj T* (    return None) Tj T*  T*  T* (def run_test_cases\(\):) Tj T* (    """Assert based tests, executed every time before the program starts.""") Tj T* (    pct_cases = [) Tj T* (        \(0, 20, 0.0\), \(10, 20, 50.0\), \(15, 20, 75.0\),) Tj T* (        \(20, 20, 100.0\), \(14, 20, 70.0\), \(0, 0, 0.0\),) Tj T* (    ]) Tj T* (    for present, total, expected in pct_cases:) Tj T* (        assert calculate_percentage\(present, total\) == expected, \(present, total\)) Tj T*  T* (    status_cases = [) Tj T* (        \(100.0, "REGULAR"\), \(75.0, "REGULAR"\), \(74.9, "DEFAULTER"\),) Tj T* (        \(50.0, "DEFAULTER"\), \(0.0, "DEFAULTER"\),) Tj T* (    ]) Tj T* (    for pct, expected in status_cases:) Tj T* (        assert get_status\(pct\) == expected, pct) Tj T*  T* (    mark_cases = [) Tj T* (        \("p", "P"\), \("P", "P"\), \(" present ", "P"\), \("a", "A"\),) Tj T* (        \("ABSENT", "A"\), \("x", None\), \("", None\),) Tj T* (    ]) Tj T* ET
Q
 

